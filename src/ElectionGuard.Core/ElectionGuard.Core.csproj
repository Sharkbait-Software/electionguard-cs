<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- [SkipLocalsInit] on the Montgomery kernels (MontgomeryContext.Multiply/Square) requires this. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="protobuf-net" Version="3.2.52" />
    <!--
      The election record format (EGRF v2): C# generated at build time from the one normative schema,
      proto/electionguard/egrf/v2/egrf.proto at the repository root, which every other
      implementation shares. Grpc.Tools ships protoc and is a build-only dependency; no gRPC services
      are generated. The generated types are internal: the public API stays the domain types, and
      mappers (a later S10b step) convert at the boundary.
    -->
    <PackageReference Include="Google.Protobuf" Version="3.34.1" />
    <PackageReference Include="Grpc.Tools" Version="2.80.0" PrivateAssets="All" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\proto\electionguard\egrf\v2\egrf.proto" ProtoRoot="..\..\proto" Access="Internal" GrpcServices="None" Link="RecordFormat\Proto\egrf.proto" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The Montgomery limb arithmetic is an implementation detail of MontgomeryModP.PowModP,
      so MontgomeryContext and the multiply/round-trip helpers are internal. The tests still need to
      reach them directly: a defect in carry or borrow propagation is best caught by driving one
      multiplication with hand-picked operands, not by inferring it from an exponentiation.
    -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ElectionGuard.Core.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
